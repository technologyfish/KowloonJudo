# ── 依赖目录 ──────────────────────────────
node_modules/
vendor/

# ── 构建产物 ──────────────────────────────
admin/dist/
miniprogram/dist/

# ── 环境配置（含敏感信息）─────────────────
.env
.env.local
.env.*.local

# ── 日志 ──────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── PHP / Lumen ───────────────────────────
api/storage/logs/*
!api/storage/logs/.gitkeep
api/storage/framework/cache/*
api/storage/framework/views/*
api/storage/framework/sessions/*

# ── 证书文件（敏感）──────────────────────
api/storage/cert/*.pem

# ── IDE / 编辑器 ──────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── 系统文件 ──────────────────────────────
desktop.ini
.DS_Store

# ── 小程序开发工具 ────────────────────────
miniprogram/project.private.config.json
miniprogram/unpackage/
